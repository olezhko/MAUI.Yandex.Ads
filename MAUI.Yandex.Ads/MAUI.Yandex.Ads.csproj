<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<PackageId>LATec.MAUI.Yandex.Ads</PackageId>
		<Version>1.0.1</Version>
		<Authors>Aleh Ladyka</Authors>
		<Description>Yandex Mobile Ads banner control (AdBannerView) for .NET MAUI on Android and iOS.</Description>
		<PackageTags>maui;yandex;ads;banner;android;ios</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/olezhko/MAUI.Yandex.Ads</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/olezhko/MAUI.Yandex.Ads</PackageProjectUrl>
		<PackageReleaseNotes>
1.0.1
- Android: updated Yandex Mobile Ads SDK from 7.18.6 to 8.6.0 (AppMetrica 8.5.1).
- Android: removed dependencies the SDK no longer uses (DivKit, Yatagan, AndroidSVG, Media3 ExoPlayer), which makes apps smaller.
- Breaking (Android): SDK 8 renamed MobileAds to YandexAds. Apps must call YandexAds.Initialize(...) instead of MobileAds.Initialize(...).

1.0.0
- Initial release.
		</PackageReleaseNotes>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

