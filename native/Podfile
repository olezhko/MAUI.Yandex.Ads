source 'https://cdn.cocoapods.org/'

platform :ios, '15.0'
project 'YandexAdsBridge.xcodeproj'

target 'YandexAdsBridge' do
  # Yandex Mobile Ads SDK 8 (pulls AppMetrica* and DivKitBinaryCompatibilityFacade).
  # No use_frameworks!: pods build as static libs and are linked into
  # YandexAdsBridge.framework, so the .NET side only needs ONE framework.
  pod 'YandexMobileAds', '8.6.0'

  # Uncomment if you need InStream ads:
  # pod 'YandexMobileAdsInstream', '0.77.0'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
    end
  end
end
